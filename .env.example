# ===== Backend Configuration =====
NODE_ENV=development
BACKEND_PORT=5000
BACKEND_HOST=localhost

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRY=7d

# Redis
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# ===== Frontend Configuration =====
REACT_APP_API_URL=http://localhost:5000
REACT_APP_API_TIMEOUT=30000

# ===== AI Service Configuration =====
PYTHON_ENV=development
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0

# LLM API Keys
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-your-anthropic-key-here
OLLAMA_BASE_URL=http://localhost:11434

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ===== Database Configuration =====
DB_TYPE=postgresql
DB_HOST=postgres
DB_PORT=5432
DB_USER=kai9000_user
DB_PASSWORD=kai9000_password_change_this
DB_NAME=kai9000
DATABASE_URL=postgresql://kai9000_user:kai9000_password_change_this@postgres:5432/kai9000

# ===== Email Configuration (Optional) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@kai9000.com

# ===== Logging =====
LOG_LEVEL=info
LOG_FORMAT=json

# ===== Security =====
CORS_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# ===== Feature Flags =====
ENABLE_WEBSOCKET=true
ENABLE_FILE_UPLOAD=true
ENABLE_TASK_SCHEDULER=true
MAX_FILE_SIZE=10485760

# ===== API Rate Limiting =====
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100

# ===== Development Only =====
DEBUG=false
SEED_DATABASE=false
